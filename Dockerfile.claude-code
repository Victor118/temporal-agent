# Image for running the Claude Code CLI.
#
# Deliberately not the agent image: this is where the arbitrary commands of a
# coding run execute, and it will grow the toolchains of whatever repos it
# works on — which have no business in the image that builds the agent.
FROM golang:1.24

# Pinned so a rebuild gets the same CLI. The installer fetches a native binary
# (no Node runtime) and checks it against the SHA256 in the release manifest.
# It installs under /root, which only root can enter: the binary is copied to
# /usr/local/bin for the user the runs are made as.
ARG CLAUDE_CODE_VERSION=2.1.280
RUN curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE_CODE_VERSION" \
 && install -m 0755 "$(readlink -f /root/.local/bin/claude)" /usr/local/bin/claude

# The user a coding run is made as. The worker runs as root, with the
# platform's credentials in its environment and the git key in a 0600 file:
# the run's shell must reach neither. The worker refuses to start the CLI as
# root without RUN_AS_UID; it hands each clone to this user for the run, and
# takes it back before its own git touches it.
RUN groupadd --gid 10001 agent-run \
 && useradd --uid 10001 --gid 10001 --no-log-init --create-home --home-dir /home/agent-run \
      --shell /usr/sbin/nologin agent-run
ENV RUN_AS_UID=10001

# Claude Code writes the commits, as agent-run; pushing stays the workflow's
# job. Without an identity, the commit fails halfway through a long run with a
# message nobody is watching for. In the system configuration, which every
# user reads; the worker's own git reads none.
RUN git config --system user.email "agent@temporal-agent.local" \
 && git config --system user.name "Temporal Agent"

# Runs happen in /work. /app is mounted read-only by compose: a coding run
# must not be able to edit the agent that started it.
WORKDIR /work
CMD ["sh", "-c", "go build -C /app -buildvcs=false -o /usr/local/bin/agent ./cmd/agent && exec agent worker"]
