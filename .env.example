# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_TLS_CERT=./certs/client.pem
# TEMPORAL_TLS_KEY=./certs/client.key
TASK_QUEUES=agent-default

# Store
